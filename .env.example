# Fora da Fila — modelo de configuração.
# Em produção o arquivo real fica FORA do public_html:
#   /home/u839930205/domains/foradafila.com.br/.env.foradafila
# (lido por bootstrap/app.php). Nunca commitar senhas.
APP_NAME="Fora da Fila"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://foradafila.com.br
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u839930205_foradafila
DB_USERNAME=u839930205_bhsoftware
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@foradafila.com.br"
MAIL_FROM_NAME="Fora da Fila"
