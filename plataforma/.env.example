# Fora da Fila — modelo de configuração.
# Em produção o arquivo real fica FORA do public_html:
#   /home/u839930205/domains/foradafila.com.br/.env.foradafila
# (lido por bootstrap/app.php). Nunca commitar senhas.
APP_NAME="Fora da Fila"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://foradafila.com.br
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u839930205_foradafila
DB_USERNAME=u839930205_bhsoftware
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# E-mail: duas contas SMTP da Hostinger (ver config/mail.php). Senhas só no .env do servidor.
#   fique@   → cadastro, ingressos, convites, senha (respondível)
#   noreply@ → avisos automáticos
# Sem senha preenchida, os e-mails vão para o log (desenvolvimento).
MAIL_MAILER=fique
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="fique@foradafila.com.br"
MAIL_FROM_NAME="Fora da Fila"
MAIL_FIQUE_USERNAME=fique@foradafila.com.br
MAIL_FIQUE_PASSWORD=
MAIL_NOREPLY_USERNAME=noreply@foradafila.com.br
MAIL_NOREPLY_PASSWORD=

# Comprador pode cancelar sozinho a inscrição gratuita até o início do evento.
FF_COMPRADOR_CANCELA_GRATUITO=true

# Imagens dos eventos: fora do public_html em produção (a publicação reescreve o public_html).
# Em branco = storage/app/midia (desenvolvimento).
FF_ARMAZENAMENTO=/home/u839930205/domains/foradafila.com.br/armazenamento
